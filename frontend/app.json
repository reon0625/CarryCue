{
  "expo": {
    "name": "CarryCue",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "carrycue",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.carrypreview.rbhkko",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Detect when you leave home to trigger reminders.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "CarryCue needs Always location access to remind you when you leave home, even when the app is closed.",
        "NSLocationAlwaysUsageDescription": "CarryCue reminds you about items when you leave home — this requires Always location access.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.emergent.carrypreview.rbhkko",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#FF6B35"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Detect when you leave home to trigger reminders.",
          "locationAlwaysAndWhenInUsePermission": "CarryCue needs Always location access to remind you when you leave home, even when the app is closed.",
          "locationAlwaysPermission": "CarryCue reminds you about items when you leave home — this requires Always location access.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "427d3487-eea5-41cd-8d0c-9ac0e2cb0670"
      }
    }
  }
}
